{
    "description": "Hyper: launch/focus apps",
    "manipulators": [
        {
            "from": {
                "key_code": "caps_lock",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "left_shift",
                    "modifiers": ["left_command", "left_control", "left_option"]
                }
            ],
            "to_if_alone": [{ "key_code": "escape" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "s",
                "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
            },
            "to": [{ "shell_command": "open -a Slack" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "t",
                "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
            },
            "to": [{ "shell_command": "open -a Alacritty" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "r",
                "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
            },
            "to": [{ "shell_command": "open -a RustRover" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "c",
                "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
            },
            "to": [{ "shell_command": "open -a Codex" }],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "g",
                "modifiers": { "mandatory": ["left_command", "left_control", "left_option", "left_shift"] }
            },
            "to": [{ "shell_command": "open -a 'Google Chrome'" }],
            "type": "basic"
        }
    ]
}
